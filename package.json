{
  "name": "lingyun-attendance",
  "version": "2.1.0",
  "description": "灵韵考勤打卡 - 桌面版",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "electron:dev": "vite build && electron .",
    "build:win": "vite build && electron-builder --win && node scripts/hash-manifest.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.{ts,vue}' 'electron/**/*.js' 'shared/**/*.js'"
  },
  "keywords": [
    "attendance",
    "electron",
    "vue"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "pinia": "^3.0.0",
    "uuid": "^14.0.2",
    "vue": "^3.5.38",
    "vue-router": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.9.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "com.lingyun.attendance",
    "productName": "灵韵考勤打卡",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "shared/**/*",
      "package.json"
    ],
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "artifactName": "LingyunCheckin-Setup-${version}.${ext}",
    "win": {
      "icon": "public/app.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "public/app.ico",
      "uninstallerIcon": "public/app.ico",
      "installerHeaderIcon": "public/app.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "Lwh9545",
      "repo": "lingyun-checkin",
      "releaseType": "release"
    }
  }
}
